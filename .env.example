# Local development: Vite proxies /api/* to this backend.
VITE_API_BASE_URL=https://heroic-wonder-production-0ffd.up.railway.app

# Supabase project settings. The anon key is public; never use a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set true only when intentionally exploring the local demo fixtures.
VITE_DEMO_MODE=false
