```gitignore
# ==============================
# Dependencies
# ==============================
node_modules/
.pnp/
.pnp.js

# ==============================
# Environment variables & secrets
# ==============================
.env
.env.*
!.env.example

# ==============================
# Build output
# ==============================
dist/
build/
out/

# ==============================
# TypeScript cache
# ==============================
*.tsbuildinfo

# ==============================
# Vite cache
# ==============================
.vite/

# ==============================
# Testing & coverage
# ==============================
coverage/
.nyc_output/
playwright-report/
test-results/

# ==============================
# Logs
# ==============================
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================
# Package manager caches
# ==============================
.npm/
.pnpm-store/

# ==============================
# IDE & editors
# ==============================
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.swp
*.swo

# ==============================
# Operating system files
# ==============================
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ==============================
# Temporary files
# ==============================
*.tmp
*.temp
*.bak
*.old
*.orig

# ==============================
# Local databases & data
# ==============================
*.sqlite
*.sqlite3
*.db

# ==============================
# Local environment & debugging
# ==============================
.env.local
.env.development.local
.env.test.local
.env.production.local

# ==============================
# Miscellaneous
# ==============================
.cache/
.temp/
```
