```gitignore
# Environment variables and secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
build/

# TypeScript build cache
*.tsbuildinfo

# Debug logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Package manager files
.npm/
.pnpm-store/

# Test coverage
coverage/

# Vite cache
.vite/

# IDE and editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.temp
*.bak
}
```
